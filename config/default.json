{
  "shop": {
    "homeUrl": "http://localhost:3000",
    "language": "es",
    "timezone": "Europe/Madrid",
    "currency": "EUR",
    "weightUnit": "kg"
  },
  "system": {
    "theme": "albayan",
    "extensions": [
      {
        "name": "redsys",
        "resolve": "extensions/redsys",
        "enabled": true,
        "priority": 10
      },
      {
        "name": "smtp-mail",
        "resolve": "extensions/smtp-mail",
        "enabled": true,
        "priority": 20
      },
      {
        "name": "odoo",
        "resolve": "extensions/odoo",
        "enabled": true,
        "priority": 30
      },
      {
        "name": "mobile-app",
        "resolve": "extensions/mobile-app",
        "enabled": true,
        "priority": 40
      },
      {
        "name": "tienda",
        "resolve": "extensions/tienda",
        "enabled": true,
        "priority": 50
      }
    ],
    "redsys": {
      "consumerLanguage": "001",
      "abandonedAfterHours": 3,
      "abandonedSchedule": "*/15 * * * *"
    },
    "notification_emails": {
      "from": "Fundación Andalusí <tienda@fundacionandalusi.org>",
      "order_confirmation": {
        "enabled": true,
        "templatePath": "emails/order-confirmation.html"
      },
      "customer_welcome": {
        "enabled": true,
        "templatePath": "emails/customer-welcome.html"
      },
      "reset_password": {
        "enabled": true,
        "templatePath": "emails/reset-password.html"
      },
      "shipment_created": {
        "enabled": true,
        "templatePath": "emails/shipment-created.html"
      },
      "shipment_delivered": {
        "enabled": true,
        "templatePath": "emails/shipment-delivered.html"
      }
    }
  },
  "themeConfig": {
    "copyRight": "Todos los derechos reservados.",
    "headTags": {
      "links": [
        {
          "rel": "icon",
          "href": "/brand/icon.png",
          "type": "image/png"
        },
        {
          "rel": "preconnect",
          "href": "https://fonts.googleapis.com"
        },
        {
          "rel": "preconnect",
          "href": "https://fonts.gstatic.com",
          "crossOrigin": "anonymous"
        },
        {
          "rel": "stylesheet",
          "href": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;600&family=Tajawal:wght@300;400;500;700&display=swap"
        }
      ],
      "metas": [
        {
          "name": "theme-color",
          "content": "#009240"
        }
      ]
    }
  }
}
