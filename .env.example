# Copie este fichero a .env para desarrollo local. En Azure estos valores se
# definen como "App Settings" del App Service (ver infra/ y docs/).

# --- Base de datos (Azure Database for PostgreSQL Flexible Server) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evershop
DB_USER=postgres
DB_PASSWORD=postgres
# En Azure: require
DB_SSLMODE=disable

# --- URL pública (se impone a shop.homeUrl) ---
EVERSHOP_HOME_URL=http://localhost:3000

# --- Redsys (TPV Virtual) ---
# Valores del comercio de PRUEBAS genérico publicado por Redsys.
# En producción use los datos de su banco (Portal de Administración de Redsys).
REDSYS_STATUS=1
REDSYS_ENVIRONMENT=test
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=sq7HjrUOBfKmC576ILgskD5srU870gJ7
REDSYS_CURRENCY=978
REDSYS_MERCHANT_NAME="Fundacion Andalusi"
# Vacío = todos los métodos del TPV; C = solo tarjeta; z = solo Bizum
REDSYS_PAY_METHODS=

# --- Almacenamiento de imágenes (Azure Blob Storage, solo producción) ---
# FILE_STORAGE=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=media

# --- Usuario administrador inicial (npm run setup) ---
ADMIN_FULLNAME=Administrador
ADMIN_EMAIL=admin@institutoalbayan.com
ADMIN_PASSWORD=cambie-esta-clave

# Número de proxies delante de la app (Azure App Service = 1)
TRUST_PROXY_HOPS=1

# --- Email transaccional (SMTP). Sin SMTP_HOST no se envían emails ---
# Microsoft 365: smtp.office365.com / 587 · Azure Communication Services: smtp.azurecomm.net / 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Fundación Andalusí <tienda@fundacionandalusi.org>"
